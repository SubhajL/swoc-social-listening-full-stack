import pkg from 'pg';
import dotenv from 'dotenv';
import fs from 'fs';
import path from 'path';
import { fileURLToPath } from 'url';

// Load environment variables
dotenv.config();

// Get the directory name
const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

// Setup database connection
const { Pool } = pkg;
const pool = new Pool({
  user: process.env.DB_USER || 'swoc-uat-gis-ssl-user',
  password: process.env.DB_PASSWORD || '4c0b269f763d4ce1d1d59ba0e2ef1f9c',
  host: process.env.DB_HOST || 'ec2-18-143-195-184.ap-southeast-1.compute.amazonaws.com',
  port: parseInt(process.env.DB_PORT || '15435'),
  database: process.env.DB_NAME || 'swoc-uat-gis-ssl',
  ssl: {
    rejectUnauthorized: false
  }
});

async function verifyReservoirUpdates() {
  const client = await pool.connect();
  
  try {
    // Get a sample of updated reservoirs
    const query = `
      SELECT 
        reservoir_id, 
        formatted_id,
        reservoir_name, 
        reservoir_lat, 
        reservoir_long, 
        province, 
        amphure, 
        tambon,
        updated_at
      FROM reservoir_locations
      ORDER BY updated_at DESC
      LIMIT 10;
    `;
    
    const result = await client.query(query);
    
    console.log('Recently Updated Reservoirs:');
    console.table(result.rows);
    
    // Count reservoirs with admin locations
    const countQuery = `
      SELECT 
        COUNT(*) as total,
        COUNT(CASE WHEN province IS NOT NULL THEN 1 END) as with_province,
        COUNT(CASE WHEN amphure IS NOT NULL THEN 1 END) as with_amphure,
        COUNT(CASE WHEN tambon IS NOT NULL THEN 1 END) as with_tambon
      FROM reservoir_locations;
    `;
    
    const countResult = await client.query(countQuery);
    
    console.log('\nAdmin Location Statistics:');
    console.table(countResult.rows);
    
    // Export all data to JSON
    const exportQuery = `
      SELECT * FROM reservoir_locations ORDER BY reservoir_id;
    `;
    
    const exportResult = await client.query(exportQuery);
    const outputPath = path.resolve(__dirname, '../../../../reservoir_locations_verified.json');
    fs.writeFileSync(outputPath, JSON.stringify(exportResult.rows, null, 2));
    console.log(`\nExported all data to: ${outputPath}`);
    
  } catch (error) {
    console.error(`Error verifying updates: ${error.message}`);
  } finally {
    client.release();
  }
}

// Run the function
verifyReservoirUpdates().then(() => {
  console.log('Verification completed');
  process.exit(0);
}).catch(err => {
  console.error('Error:', err);
  process.exit(1);
}); 