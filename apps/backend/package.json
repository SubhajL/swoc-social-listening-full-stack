    "@types/xlsx": "^0.0.35",
    "axios": "^1.8.4",
    "axios-retry": "^4.5.0",
    "basic-ftp": "^5.0.5",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dbffile": "^1.12.0",
    "dotenv": "^16.4.7",
    "dotenv-safe": "^9.1.0",
    "express": "^4.18.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^6.10.0",
    "path": "^0.12.7",
    "pg": "^8.14.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pm2": "^5.3.1",
    "sequelize": "^6.37.1",
    "shapefile": "^0.6.6",
    "socket.io": "^4.7.4",
    "umzug": "^3.8.2",
    "uuid": "^11.0.5",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5",
    "yargs": "^17.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dotenv-safe": "^8.1.6",
    "@types/express": "^4.17.21",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.14",
    "@types/mapbox__mapbox-sdk": "^0.13.4",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.17.17",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.11.11",
    "@types/socket.io": "^3.0.2",
    "@types/supertest": "^6.0.2",
    "@types/yargs": "^17.0.33",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
