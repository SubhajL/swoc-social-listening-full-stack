{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --debug",
    "test:watch": "jest --watch",
    "import-location-data": "tsx src/scripts/import_location_data.ts",
    "check-permissions": "tsx src/scripts/check_permissions.ts",
    "add-location-indexes": "tsx src/scripts/add_location_indexes.ts",
    "verify-location-data": "tsx src/scripts/verify_location_data.ts",
    "install-postgis": "tsx src/scripts/install_postgis.ts",
    "check-location-data": "tsx src/scripts/check_location_data.ts",
    "update-location-data": "tsx src/scripts/update_location_data.ts",
    "test-db-connection": "tsx src/scripts/test_db_connection.ts",
    "test:location": "tsx src/scripts/test_update_location.ts",
    "check-amphures": "tsx src/scripts/check_and_complete_amphures.ts",
    "check-provinces-encoding": "tsx src/scripts/check_provinces_encoding.ts",
    "check-amphures-encoding": "tsx src/scripts/check_amphures_encoding.ts",
    "db:migrate": "tsx src/scripts/run_migrations.ts",
    "create-reservoir-tables": "node src/scripts/create-reservoir-tables.mjs",
    "import-reservoir-excel": "node src/scripts/import-reservoir-excel.mjs",
    "sync-reservoir-data": "node src/scripts/sync-reservoir-data.mjs",
    "sync:reservoir": "node src/scripts/sync-reservoir-data.mjs",
    "sync:hii": "node src/scripts/sync-hii-data.mjs",
    "sync:tmd": "node src/scripts/sync-tmd-data.mjs",
    "sync:all": "node src/scripts/run-all-rainfall-sync.mjs",
    "sync:hii:scheduled": "node src/scripts/sync-hii-data.mjs --scheduled",
    "sync:hii:manual": "node src/scripts/sync-hii-data.mjs",
    "sync:tmd:scheduled": "node src/scripts/sync-tmd-data.mjs --scheduled",
    "sync:tmd:manual": "node src/scripts/sync-tmd-data.mjs",
    "sync:telemetry": "tsx src/scripts/telemetry/sync-telemetry.ts",
    "sync:telemetry:scheduled": "tsx src/scripts/telemetry/sync-telemetry.ts --scheduled",
    "sync:telemetry:manual": "tsx src/scripts/telemetry/sync-telemetry.ts",
    "sync:diagnostics:hii": "node src/scripts/sync-diagnostics.js hii",
    "sync:diagnostics:tmd": "node src/scripts/sync-diagnostics.js tmd",
    "sync:diagnostics": "node src/scripts/sync-diagnostics.js",
    "scheduler:start": "src/scripts/start-scheduler.sh",
    "scheduler:stop": "src/scripts/stop-scheduler.sh",
    "scheduler:status": "pgrep -l -f 'node.*schedule-data-sync.mjs' || echo 'Data sync scheduler is not running'",
    "scheduler:restart": "npm run scheduler:stop && npm run scheduler:start",
    "scheduler:logs": "tail -f logs/scheduler*.log",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs swoc-data-sync",
    "pm2:save": "pm2 save",
    "pm2:setup": "pm2 startup",
    "autostart:install": "src/scripts/install-autostart.sh",
    "autostart:uninstall": "src/scripts/uninstall-autostart.sh",
    "track-progress": "node src/scripts/track-sync-progress.mjs",
    "generate-report": "node src/scripts/generate-sync-report.mjs",
    "table:disable": "echo 'Usage: npm run table:disable -- --table=table_name' && node src/scripts/table-updates.mjs --disable",
    "table:enable": "echo 'Usage: npm run table:enable -- --table=table_name' && node src/scripts/table-updates.mjs --enable",
    "table:status": "echo 'Usage: npm run table:status -- --table=table_name' && node src/scripts/table-updates.mjs --status",
    "backup:thaiwater": "node src/scripts/backup-thaiwater-stations.mjs",
    "backup:thaiwater:verify": "node src/scripts/backup-thaiwater-stations.mjs --verify",
    "table:backup": "echo 'Usage: npm run table:backup -- --table=table_name' && node src/scripts/table-backup.mjs",
    "table:verify": "echo 'Usage: npm run table:verify -- --table=table_name' && node src/scripts/table-backup.mjs --verify",
    "fix:reservoir-schema": "node src/scripts/fix-reservoir-data-schema.mjs"
  },
  "dependencies": {
