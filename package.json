    "concurrently": "^8.2.2",
    "dotenv": "^16.4.7",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
