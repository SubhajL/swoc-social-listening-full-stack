{
  "name": "swoc-social-listening-fullstack",
  "private": true,
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "dev": "./clear-ports.sh && concurrently \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:frontend": "./clear-ports.sh && cd apps/frontend && npx --yes vite --port 8080",
    "dev:backend": "./clear-ports.sh && pnpm --filter backend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint",
    "fetch-telemetry": "node scripts/fetch-telemetry-data-by-hydroid.js",
    "fetch-all-telemetry": "node scripts/fetch-all-hydro-regions.js",
    "sync:hydroid": "node scripts/fetch-all-hydro-regions.js",
    "sync:hydroid:single": "node scripts/fetch-telemetry-data-by-hydroid.js",
    "sync:hydroid:schedule": "node scripts/schedule-hydroid-sync.js",
    "sync:reservoir": "node apps/backend/src/scripts/sync-reservoir-data.mjs",
    "sync:hii": "cd apps/backend && node -r dotenv/config src/scripts/sync-hii-data.mjs",
    "sync:tmd": "node apps/backend/src/scripts/sync-tmd-data.mjs",
    "sync:all": "cd apps/backend && node -r dotenv/config src/scripts/run-all-rainfall-sync.mjs",
    "// ⚠️ DEPRECATED SCHEDULER COMMANDS - DO NOT USE": "Use the Backend Scheduler commands instead (cd apps/backend && npm run scheduler:start/stop/status)",
    "// ⚠️ LEGACY COMPONENTS": "These commands use deprecated components in scripts/legacy/ and will be removed in a future release",
    "scheduler:run": "node scripts/legacy/scheduler-service.js run",
    "scheduler:run-once": "node scripts/legacy/scheduler-service.js run-once",
    "scheduler:status": "node scripts/legacy/scheduler-service.js status",
    "scheduler:list": "node scripts/legacy/scheduler-service.js list",
    "scheduler:install": "node scripts/install-dependencies.js",
    "autostart:install": "node scripts/autostart-manager.js install",
    "autostart:uninstall": "node scripts/autostart-manager.js uninstall"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/crypto-js": "^4.2.2",
    "@types/node-fetch": "^2.6.12",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "dotenv": "^16.4.7",
    "node-fetch": "^2.7.0",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "vitest": "^1.6.0"
  },
  "dependencies": {
    "@googlemaps/google-maps-services-js": "^3.4.0",
    "@types/pg": "^8.11.11",
    "@types/pino": "^7.0.4",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.0",
    "axios": "^1.8.4",
    "crypto-js": "^4.2.0",
    "csv-parse": "^5.6.0",
    "dayjs": "^1.11.13",
    "node-cron": "^3.0.3",
    "oauth-1.0a": "^2.2.6",
    "path": "^0.12.7",
    "pg": "^8.14.1",
    "pidusage": "^3.0.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sonner": "^1.5.0",
    "uuid": "^11.1.0",
    "ws": "^8.18.1",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.3"
  }
}
